{
  "expo": {
    "name": "Wikipati",
    "slug": "wikipati",
    "scheme": "wikipati",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wikipati.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wikipati.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "runtimeVersion": { "policy": "appVersion" },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F9F5",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wikipati, dostunuzun profil fotoğrafını seçmek için galerinize erişir.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wikipati, yakındaki veteriner kliniklerini bulmak için konumunu kullanır."
        }
      ],
      "expo-secure-store"
    ]
  }
}
